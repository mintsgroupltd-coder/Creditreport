# PostgreSQL connection string (Railway/Render/local docker-compose all provide one of these)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_report_analyzer?schema=public"

# Long random string used to sign JWTs — generate with `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-string"

# Access token lifetime
JWT_EXPIRES_IN="7d"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend's URL)
CORS_ORIGIN="http://localhost:5173"

# Max upload size in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# Used to build the link inside a password-reset email. Optional — falls
# back to CORS_ORIGIN's first entry if unset.
FRONTEND_URL="http://localhost:5173"

# Optional SMTP settings for sending password-reset emails. Without these,
# reset links are just logged to the backend console instead of emailed —
# fine for local dev, not for real users.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey-or-username"
# SMTP_PASS="replace-with-your-smtp-password"
# SMTP_FROM="no-reply@yourdomain.com"

# Optional — required only to enable POST /api/disputes/run-reminders
# (deadline-passed and periodic recheck reminder emails). Generate with
# `openssl rand -hex 32` and call the route with header
# `x-internal-secret: <this value>` from an external scheduler. Leave
# unset to disable the route entirely (it 404s).
# INTERNAL_TASK_SECRET="replace-with-a-long-random-string"
