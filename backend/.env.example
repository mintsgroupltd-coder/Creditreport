# PostgreSQL connection string (Railway/Render/local docker-compose all provide one of these)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/credit_report_analyzer?schema=public"

# Long random string used to sign JWTs — generate with `openssl rand -hex 32`
JWT_SECRET="replace-with-a-long-random-string"

# Access token lifetime
JWT_EXPIRES_IN="7d"

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call the API (your frontend's URL)
CORS_ORIGIN="http://localhost:5173"

# Max upload size in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760
