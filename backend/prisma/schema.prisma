// Data model for the UK Credit Report Analyzer.
// Design notes live in the root README under "How the data model fits together".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Bureau {
  EXPERIAN
  EQUIFAX
  TRANSUNION
  UNKNOWN
}

enum AccountStatus {
  ACTIVE
  SETTLED
  DEFAULT
  SATISFIED
  CLOSED
  UNKNOWN
}

enum EventType {
  DEFAULT
  ARREARS
  CCJ
  SEARCH
  ELECTORAL_ROLL
  LINKED_ADDRESS
}

enum AlertType {
  DOB_MISMATCH
  NAME_VARIATION
  MIXED_FILE_RISK
  DUPLICATE_ACCOUNT
  HIGH_UTILISATION
  UNSATISFIED_CCJ
  ACTIVE_DEFAULT
  SEARCH_VOLUME
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DisputeStatus {
  SENT
  RESOLVED
  NO_RESPONSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // The user's own confirmed identity — used to auto-fill the
  // "[Your name]" / "[Your address]" placeholders in generated dispute
  // letters, and (once all three of fullName/dateOfBirth/postalAddress
  // are set) to cross-check each report's own self-reported application
  // details against what the user themselves says is true, catching a
  // case even the internal mixed-file check can't: a report whose own
  // "Application Details" section doesn't match the account holder.
  // "Confirmed" here means self-declared by the account holder, NOT
  // independently verified against any official register — the app
  // doesn't have access to one, and says so wherever this is shown.
  fullName      String?
  postalAddress String?   @db.Text
  dateOfBirth   DateTime?
  // Self-declared, not checked against the actual electoral roll (no
  // API for that exists for this app to call) — offered because CRAs
  // themselves often weigh electoral roll registration when resolving
  // an identity/address dispute, so it's useful supporting context in
  // a letter when the user says they're registered. Null = not stated.
  electoralRollRegistered Boolean?
  // Set once fullName + dateOfBirth + postalAddress are all non-blank;
  // cleared if any of them is cleared. Drives the "confirmed" vs
  // "unconfirmed" identity state surfaced in the UI and used to gate
  // the profile-vs-report check above.
  identityConfirmedAt     DateTime?

  // Password reset — resetTokenHash stores a SHA-256 hash of the token
  // emailed to the user (never the raw token itself), so a DB read alone
  // can't be used to reset the account.
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  // Two-factor auth (TOTP, RFC 6238) — totpSecret is only meaningful once
  // totpEnabled is true (a secret can exist mid-enrollment before the
  // user has confirmed a code, so gate on totpEnabled, not secret
  // presence). Backup codes are stored as bcrypt hashes, one consumed
  // (removed from the array) per use — never store them raw.
  totpSecret           String?
  totpEnabled          Boolean @default(false)
  totpBackupCodeHashes Json? // string[] of bcrypt hashes

  // Opt-in periodic "time to re-check your credit file" email — null/0
  // means off. Set from Settings; lastRecheckReminderAt guards against
  // re-sending until that many months have passed again.
  recheckReminderMonths Int?
  lastRecheckReminderAt DateTime?

  reports         Report[]
  disputeRecords  DisputeRecord[]
  sessions        Session[]
  auditLogEntries AuditLogEntry[]
}

/// One issued login session, keyed by the JWT's own `jti` claim so a
/// token can be revoked (log out this device / log out everywhere)
/// despite JWTs otherwise being stateless — requireAuth checks this
/// table isn't revoked on every request. `label` is a best-effort,
/// coarse User-Agent summary ("Chrome on macOS"), never a precise
/// fingerprint, and purely descriptive — it plays no role in auth.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

/// A time-limited, revocable link letting someone without an account
/// (a solicitor, a debt adviser) view one report read-only. Only the
/// SHA-256 hash of the token is stored, same pattern as the password
/// reset token, so a database read alone can't be used as the link.
model ShareLink {
  id           String    @id @default(cuid())
  reportId     String
  report       Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  viewCount    Int       @default(0)

  @@index([reportId])
}

/// A record that something sensitive happened to an account or a
/// report — viewed, downloaded, shared — surfaced back to the user on
/// the settings page so they have visibility into their own account's
/// activity. Deliberately coarse (an action label + optional short
/// detail), not a full request log.
model AuditLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String?
  action    String // e.g. "VIEW_REPORT" | "DOWNLOAD_PDF" | "CREATE_SHARE_LINK" | "SEND_DISPUTE_EMAIL"
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// One uploaded/parsed credit report belonging to a user.
model Report {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bureau         Bureau   @default(UNKNOWN)
  sourceFileName String
  sourceFileType String // "pdf" | "csv"
  uploadedAt     DateTime @default(now())
  // True only for the fixture report created by prisma/seed.ts — lets
  // the UI badge it clearly as sample data rather than a real upload,
  // so it's never mistaken for (or included alongside) a user's own
  // reports in anything identity- or dispute-related.
  isSample       Boolean  @default(false)

  // Personal details as read off the report (used for anomaly detection)
  applicantName String?
  dateOfBirth   DateTime?
  addresses     Json? // array of { line, from, to, source }

  // Raw extracted text, kept so re-analysis doesn't require re-uploading
  rawText String @db.Text

  // Computed once at upload time by the analytics engine and persisted so
  // the report detail page can show them without re-parsing the raw text.
  riskLevel        String? // "LOW" | "MEDIUM" | "HIGH" | "SEVERE"
  summary          String? @db.Text
  suggestedActions Json? // string[]

  accounts       Account[]
  events         Event[]
  alerts         Alert[]
  disputeRecords DisputeRecord[]
  shareLinks     ShareLink[]

  @@index([userId])
}

/// A lender/creditor, deduplicated by normalized name so the same
/// creditor appearing under slightly different spellings collapses to one row.
model Lender {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  // User-entered correspondence address for this lender/agent — we
  // deliberately don't ship a hardcoded directory of creditor addresses
  // (they change, and getting one wrong misdirects a dispute letter), so
  // this starts blank and the user fills it in from their own statement.
  contactAddress String?   @db.Text
  accounts       Account[]
}

/// A single credit account/facility on a report (a credit card, loan,
/// utility account, CCJ-linked facility, etc). Mirrors one "C#" block
/// on an Experian-style report or the equivalent on Equifax/TransUnion.
model Account {
  id       String  @id @default(cuid())
  reportId String
  report   Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  lenderId String
  lender   Lender  @relation(fields: [lenderId], references: [id])

  bureauRef      String? // the bureau's own reference, e.g. "C12"
  accountType    String // e.g. "Credit card", "Water", "Current account", "Loan"
  status         AccountStatus @default(UNKNOWN)
  openedDate     DateTime?
  currentBalance Decimal?      @db.Decimal(12, 2)
  creditLimit    Decimal?      @db.Decimal(12, 2)

  defaultDate      DateTime?
  defaultBalance   Decimal?  @db.Decimal(12, 2)
  satisfactionDate DateTime?

  linkedAddress String?

  statusHistory AccountStatusEntry[]
  events        Event[]

  @@index([reportId])
  @@index([lenderId])
}

/// One month's balance/status-code entry from the account's payment
/// history table — this is what powers the account timeline view.
model AccountStatusEntry {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodDate  DateTime // first-of-month marker for that history slot
  statusCode  String // "0".."6", "8", "D", "U", etc — bureau status codes
  balance     Decimal? @db.Decimal(12, 2)

  @@index([accountId, periodDate])
}

/// A dated negative-or-notable item: a default, a CCJ, a search/enquiry,
/// an electoral roll entry, or a linked-address record.
model Event {
  id        String    @id @default(cuid())
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  accountId String?
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  type      EventType
  date      DateTime
  amount    Decimal?  @db.Decimal(12, 2)
  detail    Json? // free-form: { searchedBy, applicationType, caseNumber, ... }

  @@index([reportId, type])
}

/// A finding from the analytics engine — the thing the dashboard's
/// "alerts" panel renders directly.
model Alert {
  id           String        @id @default(cuid())
  reportId     String
  report       Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type         AlertType
  severity     AlertSeverity
  message      String
  relatedRefs  Json? // e.g. { accountIds: [...], eventIds: [...] }
  createdAt    DateTime      @default(now())

  @@index([reportId])
}

/// A record that a dispute/query letter was sent for a report, so
/// progress can be tracked (sent -> resolved / no response) alongside a
/// suggested follow-up date. The deadline is advisory except for the
/// bureau-directed templates, where UK credit reference agencies commonly
/// commit to a 28-day investigation window (Consumer Credit Act 1974
/// s.159 / ICO guidance) — see `deadlineBasis`.
model DisputeRecord {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String // DisputeTemplateId, e.g. "identity" | "ccj" | "default_validation" | "general_accuracy" | "auto"
  recipient  String // short label, e.g. "Experian", "Civil National Business Centre", or a lender name

  sentAt           DateTime      @default(now())
  responseDeadline DateTime?
  deadlineBasis    String? // "statutory" | "advisory"
  status           DisputeStatus @default(SENT)
  resolvedAt       DateTime?
  notes            String?       @db.Text

  // Set only when the user explicitly sends the letter by email from
  // the app (an in-app action distinct from sentAt, which is when they
  // logged having sent it by whatever means, usually post) — see
  // disputes.controller.ts's sendDisputeEmail.
  emailSentAt DateTime?
  emailSentTo String?
  // Set once a "deadline passed, no response" reminder email has gone
  // out for this dispute, so the scheduled reminder run never repeats it.
  reminderSentAt DateTime?

  @@index([reportId])
  @@index([userId])
}
